# Environment Configuration for Cyber AI Agent Backend

# Port to run Express server
PORT=5001

# MongoDB Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/cyber_ai_agent

# Groq API Key (Get yours from https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq LLM Model name
GROQ_MODEL=llama-3.3-70b-versatile
